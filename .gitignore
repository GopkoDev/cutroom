node_modules/
dist/
.DS_Store
*.log

# `tsc -b` drops these beside each tsconfig it builds
*.tsbuildinfo

# Playwright
test-results/
playwright-report/

# Generated fixtures — regenerate with `pnpm fixtures`. Video, audio and stills alike:
# make-fixtures.ts is deterministic, and the ten-minute and seventy-minute files have no
# business in git history.
packages/engine/test/fixtures/*
!packages/engine/test/fixtures/.gitkeep

# Local-only development plan view — regenerate rather than track
plan.html

# SDD (Claude Code plugin sdd@sdd): per-developer settings and the implement engine's worktrees
.claude/*.local.md
.worktrees/

